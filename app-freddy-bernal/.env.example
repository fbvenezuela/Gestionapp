# Copia este archivo a .env.local para trabajar en local (no se sube al repositorio).
# En Vercel, cada variable va en Settings > Environment Variables, por ambiente
# (Development, Preview = fb-dev, Production = fb-prod).
# Sin DATABASE_URL la app arranca en MODO DEMOSTRACIÓN: base en memoria con datos inventados.

# --- App ---
# URL pública de la app (para los links de los correos). En Vercel se deduce sola si se deja vacía.
APP_URL=
# Zona horaria de todas las fechas y horas.
APP_TZ=America/Caracas
# Archivo del cliente en config/clients/<APP_BRAND>.json (marca, categorías, fórmulas, horarios).
APP_BRAND=fb
# Solo para el modo demostración: firma la cookie de sesión. Pon una cadena larga al azar.
SESSION_SECRET=
# Solo modo demostración: entrar con un toque por rol, sin código ni doble factor (para probar).
# Con DATABASE_URL (datos reales) nunca funciona, diga lo que diga. false = flujo completo con código y doble factor.
DEMO_SHORTCUTS=true

# --- Supabase (proyecto fb-dev en pruebas, fb-prod en producción) ---
# Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Settings > API > anon / publishable key. Es pública: puede ir al navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Settings > API > service_role / secret key. SOLO SERVIDOR. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Settings > Database > Connection string > Transaction pooler (puerto 6543), con la contraseña de la base.
# Con esta variable la app deja el modo demostración y usa la base real (RLS siempre activo).
DATABASE_URL=

# --- Correo (Resend) ---
# outbox = los correos solo se guardan en la tabla outbox (Ajustes > Buzón). send = se envían de verdad.
EMAIL_MODE=outbox
# Remitente. Hasta verificar un dominio, Resend solo deja enviar desde onboarding@resend.dev al dueño de la cuenta.
EMAIL_FROM=Operaciones 360 <onboarding@resend.dev>
# resend.com > API Keys (permiso "Sending access"). Solo servidor.
RESEND_API_KEY=

# --- IA (copies; luego análisis de métricas) ---
# false = todo funciona con plantillas, sin gastar.
AI_ENABLED=false
AI_PROVIDER=anthropic
# Modelo a usar (no está fijo en el código). Recomendado: claude-opus-5-5 (o claude-sonnet-5-5 para gastar menos).
AI_MODEL=claude-opus-5-5
# console.anthropic.com > API Keys. Solo servidor.
ANTHROPIC_API_KEY=
# Tope de gasto mensual en dólares; al llegar, vuelve a las plantillas.
AI_MONTHLY_CAP_USD=20

# --- Publicar en redes ---
# Apagado por defecto. Nada sale a las redes sin el OK explícito de Juan.
PUBLISHING_ENABLED=false
# manual | simulated | (más adelante) api
PUBLISHER_META=manual
PUBLISHER_X=manual
PUBLISHER_TIKTOK=manual
PUBLISHER_YOUTUBE=manual

# --- Tareas programadas ---
# Cadena larga al azar. Vercel Cron la manda sola; pg_cron debe mandarla como "Authorization: Bearer ...".
CRON_SECRET=

# --- Subidas ---
# Tamaño de cada parte en MB para el modo demostración (Supabase usa 6 MB fijo).
UPLOAD_CHUNK_MB=4
