# Copia este archivo a .env.local para trabajar en local (no se sube al repositorio).
# En Vercel, cada variable va en Settings > Environment Variables, por ambiente
# (Development, Preview = fb-dev, Production = fb-prod).
# Sin DATABASE_URL la app arranca en MODO DEMOSTRACIÓN: base en memoria con datos inventados.

# --- App ---
# URL pública de la app (para los links de los correos). En Vercel se deduce sola si se deja vacía.
APP_URL=
# Correo de contacto que muestran las páginas públicas /privacidad y /condiciones (no es secreto).
CONTACT_EMAIL=
# Código de Google Search Console (etiqueta HTML) si Google pide verificar el dominio para publicar la app de Drive.
GOOGLE_SITE_VERIFICATION=
# Zona horaria de todas las fechas y horas.
APP_TZ=America/Caracas
# Archivo del cliente en config/clients/<APP_BRAND>.json (marca, categorías, fórmulas, horarios).
APP_BRAND=fb
# Solo para el modo demostración: firma la cookie de sesión. Pon una cadena larga al azar.
SESSION_SECRET=
# Solo modo demostración: entrar con un toque por rol, sin código ni doble factor (para probar).
# Con DATABASE_URL (datos reales) nunca funciona, diga lo que diga. false = flujo completo con código y doble factor.
DEMO_SHORTCUTS=true

# --- Supabase (proyecto fb-dev en pruebas, fb-prod en producción) ---
# Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Settings > API > anon / publishable key. Es pública: puede ir al navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Settings > API > service_role / secret key. SOLO SERVIDOR. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Settings > Database > Connection string > Transaction pooler (puerto 6543), con la contraseña de la base.
# Con esta variable la app deja el modo demostración y usa la base real (RLS siempre activo).
DATABASE_URL=

# --- Correo (Resend) ---
# outbox = los correos solo se guardan en la tabla outbox (Ajustes > Buzón). send = se envían de verdad.
EMAIL_MODE=outbox
# Remitente. Hasta verificar un dominio, Resend solo deja enviar desde onboarding@resend.dev al dueño de la cuenta.
EMAIL_FROM=Operaciones 360 <onboarding@resend.dev>
# resend.com > API Keys (permiso "Sending access"). Solo servidor.
RESEND_API_KEY=

# --- IA (copies; luego análisis de métricas) ---
# false = todo funciona con plantillas, sin gastar.
AI_ENABLED=false
AI_PROVIDER=anthropic
# Modelo a usar (no está fijo en el código). Recomendado: claude-opus-5-5 (o claude-sonnet-5-5 para gastar menos).
AI_MODEL=claude-opus-5-5
# console.anthropic.com > API Keys. Solo servidor.
ANTHROPIC_API_KEY=
# Tope de gasto mensual en dólares; al llegar, vuelve a las plantillas.
AI_MONTHLY_CAP_USD=20

# --- Publicar en redes ---
# Apagado por defecto. Nada sale a las redes sin el OK explícito de Juan.
PUBLISHING_ENABLED=false
# manual | simulated | (más adelante) api
PUBLISHER_META=manual
PUBLISHER_X=manual
PUBLISHER_TIKTOK=manual
PUBLISHER_YOUTUBE=manual

# --- Avisos al teléfono (Web Push) ---
# Gratis. Sin claves propias se derivan de SESSION_SECRET. PUSH_ENABLED=false los apaga.
PUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:avisos@su-dominio

# --- Asistente del equipo (docs/ASISTENTE.md) ---
# Vacío = asistente de demostración sin IA (contesta con fichas y guiones).
# Solo con el OK legal: "proveedor:modelo,proveedor:modelo" (proveedores distintos).
# Proveedores: gemini, groq, openai, openrouter, mistral. Anthropic no (no da servicio en Venezuela).
ASISTENTE_ENABLED=true
ASISTENTE_MODELOS=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# --- Tareas programadas ---
# Cadena larga al azar. Vercel Cron la manda sola; pg_cron debe mandarla como "Authorization: Bearer ...".
CRON_SECRET=

# --- Subidas ---
# Tamaño de cada parte en MB para el modo demostración (Supabase usa 6 MB fijo).
UPLOAD_CHUNK_MB=4

# --- Google Drive (docs/DRIVE.md) ---
# Vacío = todo como hoy. drive = los archivos NUEVOS van al Drive del cliente.
# Con Drive, APP_URL tiene que ser la dirección de producción: Google solo vuelve a las direcciones registradas.
# En Vercel ponla SOLO en Production (desmarca Preview y Development): la demo no se toca.
# Sin DATABASE_URL (demo) solo cuenta junto con DRIVE_FAKE=1.
STORAGE_PROVIDER=
# Google Cloud > APIs y servicios > Credenciales > cliente OAuth tipo "Aplicación web".
GOOGLE_CLIENT_ID=
# El secreto de ese mismo cliente. SOLO SERVIDOR.
GOOGLE_CLIENT_SECRET=
# Google Cloud > IAM y administración > Configuración > Número del proyecto (lo usa el Picker).
GOOGLE_PROJECT_NUMBER=
# Clave de API restringida a "Google Picker API" y a los sitios de la app y https://docs.google.com/*.
# Solo llega al navegador de Administración.
GOOGLE_PICKER_API_KEY=
# Opcional: 32 bytes al azar en base64 para cifrar el permiso de Drive. Vacío = se deriva de SESSION_SECRET
# (entonces SESSION_SECRET tiene que estar puesto y no cambiar). SOLO SERVIDOR.
DRIVE_TOKEN_KEY=
# Vacío = el video va del teléfono directo a Drive. proxy = pasa por la plataforma (gasta transferencia de
# Vercel): solo con el OK de Juan.
DRIVE_UPLOAD_MODE=
# Tope al mes, en GB, de lo que la plataforma sirve desde Drive (ver, adelantar, descargar). Vercel Hobby
# incluye unos 10 GB y pausa el proyecto si se pasa. Cada persona puede usar al día hasta la cuarta parte
# (Administración aparte). 0 = sin tope (Vercel Pro).
DRIVE_TRANSFER_CAP_GB=7
# Solo pruebas y demo: Drive falso en memoria. Con DATABASE_URL no hace nada.
DRIVE_FAKE=
