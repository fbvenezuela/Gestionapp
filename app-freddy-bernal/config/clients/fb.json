     "key": "interest",
     "label": "Interés",
     "hint": "Qué está pasando."
    },
    {
     "key": "desire",
     "label": "Deseo",
     "hint": "Qué cambia para la gente."
    },
    {
     "key": "action",
     "label": "Acción",
