    }
   ]
  },
  {
   "code": "PAS",
   "name": "PAS: problema, agitación, solución",
   "description": "El problema, por qué importa y cómo se resuelve.",
   "steps": [
    {
     "key": "problem",
     "label": "Problema",
     "hint": "Qué pasaba."
    },
    {
     "key": "agitation",
     "label": "Agitación",
     "hint": "A quién afecta y cuánto (solo cifras de la ficha)."
    },
    {
     "key": "solution",
     "label": "Solución",
     "hint": "Qué se hizo o se va a hacer, con plazos si los hay."
    }
   ]
  },
  {
   "code": "AIDA",
   "name": "AIDA: atención, interés, deseo, acción",
