      "formats": {
        "video": { "min_duration_s": 3, "max_duration_s": 600, "aspects": ["9:16"], "aspect_tolerance": 0.02, "min_width": 360, "min_height": 360, "max_width": 4096, "max_size_mb": 4096, "min_fps": 23, "max_fps": 60, "video_codecs": ["avc", "h264", "hevc", "h265", "vp8"], "audio_codecs": ["aac", "mp3", "opus"] }
      }
    },
    {
      "network": "threads",
      "label": "Threads",
      "length_group": "medium",
      "copy_max_chars": 500,
      "source_url": "https://developers.facebook.com/docs/threads/overview",
      "notes": "",
      "formats": {
        "video": { "max_duration_s": 300, "max_size_mb": 1024, "min_fps": 23, "max_fps": 60, "max_width": 1920, "video_codecs": ["avc", "h264", "hevc", "h265"], "audio_codecs": ["aac"] }
      }
