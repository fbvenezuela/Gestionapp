# Importer of the old website (scripts/web-import): its reports name every old post. Never in git (it refuses to write
# them inside the repository anyway).
scripts/web-import/*.json
.web-import/

# Google OAuth client files (client_secret_*.json): never in git. The values go to Vercel / .env.local.
client_secret*.json
# Real content of the official site for the demo (REAL_SITE_CONTENT, written by the build's «prebuild»,
# scripts/real-site): its snapshot, photos and PDFs. Never in git (the repository is public).
.real-site/
.real-site.*.tmp/
